<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <rect width="800" height="500" fill="#fcfbf7" />
  <!-- Notebook lines -->
  <line x1="0" y1="120" x2="800" y2="120" stroke="#fca5a5" stroke-width="1.5" />
  <line x1="0" y1="200" x2="800" y2="200" stroke="#93c5fd" stroke-width="1" />
  <line x1="0" y1="250" x2="800" y2="250" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="6 4" />
  <line x1="0" y1="300" x2="800" y2="300" stroke="#93c5fd" stroke-width="1" />
  <line x1="0" y1="380" x2="800" y2="380" stroke="#93c5fd" stroke-width="1" />
  <line x1="0" y1="430" x2="800" y2="430" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="6 4" />
  <line x1="0" y1="480" x2="800" y2="480" stroke="#93c5fd" stroke-width="1" />
  <line x1="90" y1="0" x2="90" y2="500" stroke="#f87171" stroke-width="1.5" />

  <!-- Handwriting Text (Child Style) -->
  <g font-family="'Comic Sans MS', 'Caveat', cursive, sans-serif" fill="#1e293b">
    <text x="120" y="180" font-size="38" font-weight="bold">The quick brown fox</text>
    <text x="120" y="290" font-size="38" font-weight="bold">jumps over the</text>
    <text x="120" y="370" font-size="38" font-weight="bold">lazy dog. 1 2 3</text>
    <text x="120" y="470" font-size="34" font-style="italic" fill="#475569">A B C D E F G</text>
  </g>
</svg>
