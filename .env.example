# Port configuration (hardcoded to 3000 in AI Studio)
PORT=3000

# MongoDB Database Connection String (optional, app supports standalone fallback mode)
MONGO_URI=

# JWT Secret for authentication session signing
JWT_SECRET=

# Email OTP Service via Nodemailer (Gmail / SMTP)
EMAIL_USER=
EMAIL_PASS=

# SMS OTP Service via TextBee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Python Executable for Handwriting ML (optional)
HANDWRITING_PYTHON=
